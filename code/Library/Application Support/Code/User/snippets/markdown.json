{
	"Insert Raw HTML": {
		"prefix": "raw",
		"body": [
			"{{</* raw */>}}",
			"${1:markdown_content}",
			"{{</* /raw */>}}"
		],
		"description": "Insert Raw HTML"
	},
	"Insert Code": {
		"prefix": "code",
		"body": [
			"``` ${1|html,python,md,bash,javascript,json|}",
			"${2:markdown_content}",
			"```"
		],
		"description": "Insert Code"
	},
	"Markdown link": {
		"prefix": "link",
		"body": [
			"[${1:link_text}](${2:link_url})"
		],
		"description": "Markdown link"
	}
}
