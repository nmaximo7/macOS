# =============================================================================
#  .env.example  -  safe template for the Hugo Content Toolkit
#
#  1. Copy it:      cp .env.example .env      (the .env goes NEXT TO myconfig.py)
#  2. Edit the values below.  Lines that start with # are comments / optional.
#  3. NEVER commit .env (it is listed in .gitignore) and never paste it in chats.
#
#  Rules of the format (python-dotenv):
#   - One KEY=value per line; spaces around "=" are allowed.
#   - Put comments on their OWN line. A " # comment" after an unquoted value
#     also works, but a value that itself contains " #" would be cut.
#   - Use "double quotes" when a value contains spaces.
#   - Values in .env win over variables already set in your shell.
#
#  Check what the project really sees at any time:    python3 myconfig.py
# =============================================================================


# ---- Hugo site  (REQUIRED for check_links / check_images / check_render / quotes)
# Where `hugo server` answers, as seen from THIS computer. "http://" is optional.
# Start Hugo with:  hugo server --bind 0.0.0.0
HUGO_SERVER=192.168.1.46:1313

# Folder of the site on THIS computer: the one that contains content/ and static/.
HUGO_ROOT=/path/to/your/hugo/site


# ---- Ollama  (front matter, myollama.py)
# Address of the Ollama server.                          default: http://localhost:11434
BASE_URL=http://127.0.0.1:11434

# Model used when no model is named (front matter, summaries).   default: qwen3:32b
# It must exist locally: check with `ollama list`, install with `ollama pull <name>`.
MYMODEL_QUERY=qwen3:32b

# Models used to expand content, separated by spaces or commas.     default: none
MODELS_NEWCONTENT="qwen3.8:27b qwen2.5-coder:1.5b"

# Seconds to wait for an answer (big local models are slow).           default: 600
# OLLAMA_TIMEOUT=600

# Context window in tokens, to avoid silent truncation of long pages.  default: Ollama's
# OLLAMA_NUM_CTX=32768


# ---- Quotes  (provide_quotes)
# Subject: technology, maths, science, humor, wisdom, education, any word of your
# own, or "auto" (taken from each page's front matter). Empty = any subject.
TOPIC=technology

# How many quotes to propose for each article.                         default: 3
NUMBER_QUOTES=7

# A fortunes file, or a folder of them ("%" between quotes, "    -- Author" last).
# No default: without it the "file" quote source is skipped.
FORTUNES_PATH=/path/to/your/fortunes

# Where quotes come from, in order of preference. Choose among:
#   file       your FORTUNES_PATH
#   fortune    the system "fortune" command   (brew install fortune)
#   library    the Python package quotes-library   (Python 3.11+)
#   zenquotes  free online API (needs internet, ~5 requests / 30 s)
#   dummyjson  free online API (needs internet)
#   (also used by the daily dashboard quote)  default: file fortune
QUOTE_SOURCES="file fortune library zenquotes dummyjson"


# ---- Daily dashboard  (greetings.py)
# News feeds, separated by spaces.
RSS_FEED_URLS="https://example.com/feed.xml https://example.org/rss"

# City of the weather line. Empty/missing = wttr.in guesses it from your IP address.
WEATHER_CITY=London

# Language of the weather line: en, es, fr, de...                      default: en
WEATHER_LANG=en

# Stocks shown, separated by spaces or commas.      default: the 10 below
STOCK_TICKERS="AAPL MSFT GOOGL AMZN TSLA BRK-B NVDA META JPM V"

# ---- Front matter  (check_hugo_frontmatter)
# Value of "author:" proposed for every page. Empty/missing = leave each page's own author alone.
AUTHOR="Your Name"

# Value of "featured_image:" proposed when a page has none. Empty/missing = propose none.
FEATURED_IMAGE=/images/default.jpg


# ---- Article rewrite  (content_expand.py, step "expand" of content_creation.py)
# Who rewrites the article: openrouter (hosted, needs the key in the Keychain) or ollama (your local model).
#                                                                       default: openrouter
EXPAND_PROVIDER=openrouter

# Hosted model. "openrouter/free" lets OpenRouter pick a free one; for long careful rewrites
# choose a specific model id from openrouter.ai/models with a large context window.
#                                                                       default: openrouter/free
OPENROUTER_MODEL=openrouter/free

# Seconds to wait for OpenRouter (rewriting a long article takes minutes).   default: 300
OPENROUTER_TIMEOUT=300

# Cap on the answer length in tokens. Empty = the model's own limit.        default: none
#OPENROUTER_MAX_TOKENS=16000

# Folder for the expanded copies. NEVER inside your Hugo content/ folder (Hugo would publish them).
#                                                                       default: ~/hugo-expanded
#EXPAND_OUTPUT_DIR=~/hugo-expanded

# Free models are often busy. When OpenRouter gives NO answer (empty answer, busy, timeout, HTTP 429/5xx)
# the program waits and asks again; a wrong key or no credits are NOT retried (they would fail again).
#   EXPAND_RETRIES     extra attempts after the first one                 default: 2
#   EXPAND_RETRY_WAIT  seconds to wait before each new attempt (300 = 5 minutes)   default: 300
EXPAND_RETRIES=2
EXPAND_RETRY_WAIT=300


# ---- Web research with your own SearXNG  (mysearx.py, step "searx" of content_creation.py)
# One-time setup:   bash ~/macOS/scripts/searx.sh install        (see README section 9.19)
# A line starting with # is NOT used: the program then uses the default written next to it.
# Here every line is active, with the values chosen for a Mac with limited resources.

# Where SearXNG answers. If you change the port, also set SEARX_PORT in searx.conf.   default: http://127.0.0.1:8080
SEARX_URL=http://127.0.0.1:8080

# Domains to leave out of the results. PUT YOUR OWN SITE HERE so the search does not find your own article.
SEARX_EXCLUDE=your-site.example

# How many results to keep (1-50).                                      default: 8
SEARX_RESULTS=8

# Search language (en, es, all...); empty = SearXNG's default.
SEARX_LANGUAGE=en

# Categories: general, it, science, news ...
SEARX_CATEGORIES=general

# Engines to ask (comma list): duckduckgo, wikipedia, brave, bing, google ... Empty = every enabled engine.
# Only duckduckgo is the most private, but it sometimes answers with a CAPTCHA and returns nothing
# (the summary then says "no results ... duckduckgo: CAPTCHA"). If that happens, add a second one:
#   SEARX_ENGINES=duckduckgo,wikipedia
SEARX_ENGINES=duckduckgo

# Time range: day, week, month or year. Empty = any time.
#SEARX_TIME_RANGE=year

# ---- Deep research: the more information, the better the rewrite.
# For one page the step searches SEVERAL variants of the title (title, "... tutorial", "... examples",
# the description's words, title + tags ...), reads several result pages of each, merges everything into
# one list (links found by several searches first) and DOWNLOADS the text of the best pages.
# Defaults are 4 / 2 / 8 / 4000 / 30000; these are more generous (about 40 searches, about 1-2 minutes).
SEARX_QUERIES=6            # query variants (1-8)
SEARX_PAGES=3              # result pages per query (1-5)
SEARX_FETCH=1              # 1 = download the best pages and keep their text; 0 = titles and snippets only
SEARX_FETCH_PAGES=12       # how many pages to download (0-30)
SEARX_FETCH_CHARS=6000     # text kept from each downloaded page
SEARX_CONTEXT_CHARS=60000  # size of the research text given to the AI model (about 15000 tokens; max 60000 is used)
SEARX_DELAY=1.0            # seconds between two searches (engines block fast ones)
# NOTE: downloading pages is done by your Mac directly, so those sites see your IP address like any visit.
#       SEARX_FETCH=0 avoids that (only the search engines' snippets are used).

# Seconds to wait for one search.                                       default: 30
SEARX_TIMEOUT=30

# 1 = start Docker + SearXNG when they are not running; 0 = fail with a message instead.   default: 1
SEARX_AUTOSTART=1

# What to do with SearXNG after the search:
#   always = stop it EVERY time, even if it was already running (keeps the Mac light).
#            To keep it running, start it yourself with  bash ~/macOS/scripts/searx.sh start
#            and run the toolkit with --keep-searx (or set this to 1 / 0 for a while).
#   1      = stop it only when this run started it            (the default)
#   0      = never stop it
SEARX_AUTOSTOP=always

# Same idea for Docker Desktop itself (the heavy part):
#   always = quit Docker Desktop every time (it stays open only if OTHER containers are running in it)
#   1      = quit it only when searx.sh launched it            (the default)
#   0      = never quit it
SEARX_QUIT_DOCKER=always

# 1 = when SearXNG will not start (or stops answering) force-quit Docker Desktop NO MATTER WHAT it is
# doing, launch it again and try once more (searx.sh reset). Personal computer: nothing else matters.   default: 1
SEARX_RESTART=1

# Path of searx.sh. Default: ../scripts/searx.sh, ~/macOS/scripts/searx.sh, then next to mysearx.py.
SEARX_SCRIPT=~/macOS/scripts/searx.sh


# ---- Secrets (keep them OUT of this file)
# The OpenRouter API key does NOT go in .env: it lives in the system keychain
#   python3 openrouter.py --set-key
# Any other password or token is safer in the keychain too (see openrouter.py).
