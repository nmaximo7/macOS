# =============================================================================
#  .env.example  -  safe template for the Hugo Content Toolkit
#
#  1. Copy it:      cp .env.example .env      (the .env goes NEXT TO myconfig.py)
#  2. Edit the values below.  Lines that start with # are comments / optional.
#  3. NEVER commit .env (it is listed in .gitignore) and never paste it in chats.
#
#  Rules of the format (python-dotenv):
#   - One KEY=value per line; spaces around "=" are allowed.
#   - Put comments on their OWN line. A " # comment" after an unquoted value
#     also works, but a value that itself contains " #" would be cut.
#   - Use "double quotes" when a value contains spaces.
#   - Values in .env win over variables already set in your shell.
#
#  Check what the project really sees at any time:    python3 myconfig.py
# =============================================================================


# ---- Hugo site  (REQUIRED for check_links / check_images / check_render / quotes)
# Where `hugo server` answers, as seen from THIS computer. "http://" is optional.
# Start Hugo with:  hugo server --bind 0.0.0.0
HUGO_SERVER=192.168.1.46:1313

# Folder of the site on THIS computer: the one that contains content/ and static/.
HUGO_ROOT=/path/to/your/hugo/site


# ---- Ollama  (front matter, myollama.py)
# Address of the Ollama server.                          default: http://localhost:11434
BASE_URL=http://127.0.0.1:11434

# Model used when no model is named (front matter, summaries).   default: qwen3:32b
# It must exist locally: check with `ollama list`, install with `ollama pull <name>`.
MYMODEL_QUERY=qwen3:32b

# Models used to expand content, separated by spaces or commas.     default: none
MODELS_NEWCONTENT="qwen3.8:27b qwen2.5-coder:1.5b"

# Seconds to wait for an answer (big local models are slow).           default: 600
# OLLAMA_TIMEOUT=600

# Context window in tokens, to avoid silent truncation of long pages.  default: Ollama's
# OLLAMA_NUM_CTX=32768


# ---- Quotes  (provide_quotes)
# Subject: technology, maths, science, humor, wisdom, education, any word of your
# own, or "auto" (taken from each page's front matter). Empty = any subject.
TOPIC=technology

# How many quotes to propose for each article.                         default: 3
NUMBER_QUOTES=7

# A fortunes file, or a folder of them ("%" between quotes, "    -- Author" last).
# No default: without it the "file" quote source is skipped.
FORTUNES_PATH=/path/to/your/fortunes

# Where quotes come from, in order of preference. Choose among:
#   file       your FORTUNES_PATH
#   fortune    the system "fortune" command   (brew install fortune)
#   library    the Python package quotes-library   (Python 3.11+)
#   zenquotes  free online API (needs internet, ~5 requests / 30 s)
#   dummyjson  free online API (needs internet)
#   (also used by the daily dashboard quote)  default: file fortune
QUOTE_SOURCES="file fortune library zenquotes dummyjson"


# ---- Daily dashboard  (greetings.py)
# News feeds, separated by spaces.
RSS_FEED_URLS="https://example.com/feed.xml https://example.org/rss"

# City of the weather line. Empty/missing = wttr.in guesses it from your IP address.
WEATHER_CITY=London

# Language of the weather line: en, es, fr, de...                      default: en
WEATHER_LANG=en

# Stocks shown, separated by spaces or commas.      default: the 10 below
STOCK_TICKERS="AAPL MSFT GOOGL AMZN TSLA BRK-B NVDA META JPM V"

# ---- Front matter  (check_hugo_frontmatter)
# Value of "author:" proposed for every page. Empty/missing = leave each page's own author alone.
AUTHOR="Your Name"

# Value of "featured_image:" proposed when a page has none. Empty/missing = propose none.
FEATURED_IMAGE=/images/default.jpg


# ---- Article rewrite  (content_expand.py, step "expand" of content_creation.py)
# Who rewrites the article: openrouter (hosted, needs the key in the Keychain) or ollama (your local model).
#                                                                       default: openrouter
EXPAND_PROVIDER=openrouter

# Hosted model. "openrouter/free" lets OpenRouter pick a free one; for long careful rewrites
# choose a specific model id from openrouter.ai/models with a large context window.
#                                                                       default: openrouter/free
OPENROUTER_MODEL=openrouter/free

# Seconds to wait for OpenRouter (rewriting a long article takes minutes).   default: 300
OPENROUTER_TIMEOUT=300

# Cap on the answer length in tokens. Empty = the model's own limit.        default: none
#OPENROUTER_MAX_TOKENS=16000

# Folder for the expanded copies. NEVER inside your Hugo content/ folder (Hugo would publish them).
#                                                                       default: ~/hugo-expanded
#EXPAND_OUTPUT_DIR=~/hugo-expanded


# ---- Secrets (keep them OUT of this file)
# The OpenRouter API key does NOT go in .env: it lives in the system keychain
#   python3 openrouter.py --set-key
# Any other password or token is safer in the keychain too (see openrouter.py).
