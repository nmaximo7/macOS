# ~/.zsh_functions  (stow package: zsh/.zsh_functions)
# A function is a small program living in your shell. Unlike an alias it can take arguments
# anywhere ("$1", "$@"), use variables and make decisions.
# =============================================================================

# =============================================================================
# 📁 ENVIRONMENT SETUP
# =============================================================================

# HUGO_CONTENT: The primary directory for your website's Markdown files. 
# Every other script and tool relies on this environment variable so you only 
# have to change it in one place if your directory structure moves.
# This is the folder that Syncthing keeps in step with the Arch server where Hugo runs.
export HUGO_CONTENT="${HUGO_CONTENT:-/Volumes/MacDatosMaster/justtothepoint/content}"


# =============================================================================
# 📂 DIRECTORY AND FILE UTILITIES
# =============================================================================

# mkcd <dir>
# What it does: Creates a directory (including any missing parent directories) 
# and instantly `cd`s into it. 📁
# Arguments: Requires one argument (the directory name).
mkcd() {
    [[ -n $1 ]] || { echo "usage: mkcd <dir>"; return 1; }
    mkdir -p -- "$1" && cd -- "$1"
}

# searchEdit
# What it does: A fuzzy-finder for your configuration and script files. It searches 
# specific directories (~/.config, $DOTFILES, ~/.local/bin, ~/Dropbox), ignores 
# .git folders, and pipes the results into `fzf` with a live code preview powered 
# by `bat`. When you select a file, it opens it in your default $EDITOR. 🔍
# Safety: Checks if the directories actually exist before trying to search them.
# Handles spaces in names (-print0 / --read0 / xargs -0).
searchEdit() {
    local -a dirs existing
    local d
    dirs=("$HOME/.config" "$DOTFILES" "$HOME/.local/bin" "$HOME/Dropbox")
    for d in $dirs; do [[ -d $d ]] && existing+=("$d"); done
    (( ${#existing} )) || { echo "searchEdit: no folder to search"; return 1; }
    find "${existing[@]}" -type f -not -path '*/.git/*' -print0 \
        | fzf --read0 --print0 --preview 'bat --style=numbers --color=always {}' \
        | xargs -0 -o ${=EDITOR}
}


# =============================================================================
# 🧮 MATH AND CONVERSIONS
# =============================================================================

# calc "<expression>"
# What it does: A quick command-line calculator powered by the `bc` math library. 
# Since it uses `-l`, it properly handles decimals (e.g., calc "10/3"). 🧮
calc() { bc -l <<< "$*" }

# Alias mapping: `noglob` means `calc 3*4` also works without needing quotes.
alias calc='noglob calc'

# urlencode "<string>"
# What it does: Takes a raw string and encodes it into a URL-safe format using a 
# quick inline Python 3 script. Spaces become `+`, and special characters are escaped. 🔗
# Example: urlencode "hello world"  ->  hello+world
urlencode() {
    python3 -c 'import sys, urllib.parse as u; print(u.quote_plus(" ".join(sys.argv[1:])))' "$@"
}


# =============================================================================
# 🔎 HUGO CONTENT SEARCH
# =============================================================================

# myripgrep <pattern>
# What it does: Searches specifically inside your $HUGO_CONTENT directory 
# for a text pattern using `rg` (ripgrep). 🔎
myripgrep() { rg "$@" "$HUGO_CONTENT/" }

# mysearch <pattern>
# What it does: Runs `myripgrep` to find the term in your local Hugo files, 
# AND simultaneously opens your default web browser to run a Google search 
# for that exact term (using your `urlencode` function). 🌐
mysearch() {
    rg "$@" "$HUGO_CONTENT/"
    open "https://www.google.com/search?q=$(urlencode "$*")"
}

# hugo-image-posts <image-file>
# What it does: Finds every Hugo Markdown post that references a specific image. 
# It uses ripgrep to scan all .md files in $HUGO_CONTENT. 🖼️
# Smart feature: You can pass just the filename (hero.png) or the full path 
# (/some/path/hero.png). The ${1:t} modifier extracts just the base filename.
hugo-image-posts() {
  local content="$HUGO_CONTENT"
  local image="${1:t}"  # Use the filename even if you pass a full path

  if [[ -z "$1" ]]; then
    print -u2 -- "Usage: hugo-image-posts <image-file>"
    return 2
  fi

  if [[ ! -d "$content" ]]; then
    print -u2 -- "Hugo content directory not found: $content"
    return 1
  fi

  rg -F -l --sort path --hidden --no-ignore -g '*.md' -- "$image" "$content"
}


# =============================================================================
# 🎵 MEDIA UTILITIES
# =============================================================================

# ytmp3 <url>
# What it does: Downloads the audio from a YouTube video and saves it as an MP3 
# directly into your ~/Music folder. 🎵
# Dependencies: Requires `yt-dlp` and `ffmpeg` (brew install yt-dlp ffmpeg).
# Smart feature: It checks if `yt-dlp` exists first. -P sets the download folder 
# so your shell stays where it is.
ytmp3() {
    (( $+commands[yt-dlp] )) || { echo "brew install yt-dlp ffmpeg"; return 1; }
    yt-dlp --extract-audio --audio-format mp3 -P "$HOME/Music" -o '%(title)s.%(ext)s' "$@"
}

# playmp3
# What it does: Shuffles and plays all MP3 files located in your ~/Music folder 
# directly in the terminal (no video window). Quit with 'q'. 🎧
# Dependencies: Requires `mpv` (brew install mpv).
playmp3() {
    (( $+commands[mpv] )) || { echo "brew install mpv"; return 1; }
    mpv --no-video --shuffle "$HOME"/Music/*.mp3
}


# =============================================================================
# ⚙️ SYSTEM AND PROCESSES
# =============================================================================

# Archives note: the Oh My Zsh `extract` plugin gives you `extract <file>` and `x <file>`.

# free
# What it does: Simulates the Linux `free` command on macOS. Prints a quick summary 
# of physical memory and your current memory pressure percentage. 📊
# Useful to check before loading a big local AI model.
free() {
    top -l 1 -s 0 | grep PhysMem
    memory_pressure | grep 'free percentage'
}

# killport <port>
# What it does: Finds whatever process is listening on the specified TCP port 
# and forcibly kills it. Extremely useful for zombie dev servers. 💀
# Arguments: Requires the port number.
killport() {
    [[ -n $1 ]] || { echo "usage: killport <port>"; return 1; }
    local pids
    pids=$(lsof -ti tcp:"$1" -sTCP:LISTEN) || { echo "nothing is listening on port $1"; return 1; }
    echo "killing PID(s): ${pids//$'\n'/ }"
    echo "$pids" | xargs kill
}

# weather [city]
# What it does: Prints a one-line ASCII weather summary for the given city 
# using wttr.in. If no city is provided, it attempts to guess based on your IP. ☔
weather() { curl -s "wttr.in/${1:-}?format=3" }

# shutdownmac [--now]
# What it does: A comprehensive shutdown sequence for your entire setup. 🛑
# 1. Sends a shutdown command to your remote Arch server via SSH.
# 2. Sends a shutdown command to a Windows machine (192.168.1.12).
# 3. Asks for confirmation (unless you pass `--now`).
# 4. Gracefully tells the `Ghostty` terminal to quit using AppleScript.
# 5. If Ghostty refuses to close after 2 seconds, it force-kills it.
# 6. Finally, tells macOS System Events to shut down the Mac.
shutdownmac() {
  ssh -t server 'sudo shutdown -h now'
  ssh nmaxi@192.168.1.12 "shutdown /s /t 0"
  if [[ "$1" != "--now" ]]; then
    printf 'Shut down this Mac now? [y/N] '
    read -r reply
    [[ "$reply" =~ ^[Yy]$ ]] || { echo "Cancelled."; return 1; }
  fi

  # Ask Ghostty to quit normally first.
  osascript -e 'tell application "Ghostty" to quit' >/dev/null 2>&1

  # Give it a moment, then force-quit if it is still running.
  sleep 2
  if pgrep -xq Ghostty; then
    echo "Ghostty is still running; force-quitting it."
    osascript -e 'tell application "Ghostty" to quit saving no' >/dev/null 2>&1
    sleep 1
    pkill -x Ghostty 2>/dev/null || true
  fi

  # Request a normal macOS shutdown.
  osascript -e 'tell application "System Events" to shut down'
}


# =============================================================================
# 🐍 PYTHON PROJECT WRAPPERS & REMOTE EXECUTION
# =============================================================================

# greetings
# What it does: Runs your `greetings.py` daily briefing script. 👋
# Note: Runs in a SUBSHELL ( ... ): the cd and the activated virtualenv disappear 
# when it ends, so your prompt stays where it was. The venv's python is called 
# directly (no `activate` needed).
greetings() {
  local proj="$HOME/macOS/myPython"
  [[ -x "$proj/.venv/bin/python" ]] || { print -u2 "greetings: no virtualenv in $proj (see ~/macOS/docs/docMymac/mypython.md, section 5)"; return 1; }
  ( cd "$proj" && .venv/bin/python greetings.py "$@" )
}

# content_creation [page.md] [options]
# What it does: Runs your `content_creation.py` script to check and improve a Hugo page. 👩🏻‍💻
# Usage:
#   content_creation                     (the page you edited LAST in $HUGO_CONTENT)
#   content_creation calculus/x.md       (a given page)
#   content_creation --skip searx        (without web research)
# Note: Like `greetings`, runs in a subshell using the local venv python.
content_creation() {
  local proj="$HOME/macOS/myPython"
  [[ -x "$proj/.venv/bin/python" ]] || { print -u2 "content_creation: no virtualenv in $proj (see ~/macOS/docs/docMymac/mypython.md, section 5)"; return 1; }
  ( cd "$proj" && .venv/bin/python content_creation.py "$@" )
}

# start_remote_webserver
# What it does: SSHs into your Arch server and interactively runs the 
# `webserver` command under zsh. 🚀
start_remote_webserver() {
  ssh -t server -- zsh -lic 'webserver'
}
