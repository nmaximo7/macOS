# Ghostty config — symlinked to ~/.config/ghostty/config by scripts/install.sh
# Validate:  ghostty +validate-config     Inspect:  ghostty +show-config
# Reload:    Cmd+Shift+,

# --- Look ---
theme = Catppuccin Mocha
font-family = JetBrains Mono
font-size = 14
adjust-cell-height = 10%
cursor-style = bar
cursor-style-blink = false
background-opacity = 0.95
background-blur-radius = 20
window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
mouse-hide-while-typing = true

# --- Window / tabs ---
macos-titlebar-style = tabs
window-save-state = always
window-inherit-working-directory = true
confirm-close-surface = false
unfocused-split-opacity = 0.85
fullscreen = true

# --- Behaviour ---
# Option works as Alt/Meta in vim, emacs, readline
macos-option-as-alt = true
copy-on-select = clipboard
scrollback-limit = 25000000
shell-integration = detect
shell-integration-features = cursor,sudo,title

# --- Keybinds ---
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down
keybind = cmd+shift+enter=toggle_split_zoom

# Drop-down terminal from anywhere (needs Accessibility permission)
keybind = global:ctrl+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-autohide = true