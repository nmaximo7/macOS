{
  "hotkey": {
    "modifiers": [
      "command"
    ],
    "key": "d",
    "swallow": true
  },
  "window": {
    "title": "mylauncher",
    "width": 680,
    "font_size": 20,
    "top_offset": 160,
    "style": "borderless",
    "font": "Helvetica Neue",
    "colors": {
      "background": "#1c1c1f",
      "input_background": "#26262b",
      "text": "#f5f5f7",
      "muted": "#8e8e93",
      "selection": "#34343c",
      "command": "#ff9f0a"
    }
  },
  "browser": {
    "command": [
      "/Applications/Zen.app/Contents/MacOS/zen",
      "-new-tab",
      "{url}"
    ]
  },
  "autostart": {
    "label": "com.mylauncher.app",
    "log_dir": "~/Library/Logs/mylauncher",
    "keep_alive": true
  },
  "expander": {
    "enabled": true,
    "folder": "~/macOS/Espanso/Library/Application Support",
    "strip_cursor_marker": true,
    "notification": true,
    "paste": true,
    "paste_delay_ms": 250,
    "group_length": 2,
    "groups": {
      ";p": {
        "name": "prompts",
        "icon": "🧠"
      },
      ";e": {
        "name": "emoji",
        "icon": "😀"
      },
      ";b": {
        "name": "bookmarks",
        "icon": "🔖"
      },
      ";h": {
        "name": "code",
        "icon": "💻"
      }
    },
    "copy_log": "~/Library/Logs/mylauncher/copy.log"
  },
  "help": {
    "word": "help",
    "aliases_file": "~/.zsh_aliases",
    "functions_file": "~/.zsh_functions",
    "aerospace_config": "~/.config/aerospace/aerospace.toml",
    "skills_folder": "~/macOS/claude/skills",
    "help_script": "~/macOS/scripts/help.sh",
    "scripts_folder": "~/macOS/scripts",
    "cache_seconds": 600
  },
  "edit": {
    "word": "edit",
    "file": "edit.json",
    "editor": "Visual Studio Code"
  },
  "execute": {
    "word": "execute",
    "file": "execute.json",
    "shell": [
      "/bin/zsh",
      "-lc"
    ],
    "source": [
      "~/.zsh_functions"
    ],
    "terminal": false,
    "terminal_command": [
      "open",
      "-na",
      "Ghostty",
      "--args",
      "-e",
      "/bin/zsh",
      "-lc",
      "{command}"
    ],
    "log_dir": "~/Library/Logs/mylauncher/execute",
    "notify": true
  },
  "apps": {
    "word": "run",
    "folders": [
      "/Applications",
      "/System/Applications",
      "/System/Applications/Utilities",
      "~/Applications"
    ],
    "exclude": []
  },
  "search": {
    "max_results": 8,
    "max_browse_results": 100,
    "ignore_accents": true,
    "fuzzy": true
  },
  "commands": [
    {
      "id": "shutdown",
      "title": "Shutdown",
      "action": "shutdown",
      "keywords": [
        "shut down",
        "power off",
        "turn off"
      ],
      "confirm": true,
      "icon": "🔌",
      "description": "Shut down the Mac (asks first). Applications that refuse to quit are force quit after power.grace_seconds"
    },
    {
      "id": "reboot",
      "title": "Reboot",
      "action": "reboot",
      "keywords": [
        "restart",
        "reboot the mac",
        "restart the mac"
      ],
      "confirm": true,
      "icon": "🔄",
      "description": "Restart the Mac (asks first). Applications that refuse to quit are force quit after power.grace_seconds"
    },
    {
      "id": "screenshot_full_screen",
      "title": "screenshot full_screen",
      "action": "screenshot_full",
      "keywords": [
        "screenshot",
        "screen capture",
        "whole screen",
        "full screen"
      ],
      "confirm": false,
      "icon": "🖥️",
      "description": "The whole screen, saved as a file  ·  macOS shortcut ⇧⌘3"
    },
    {
      "id": "screenshot_region",
      "title": "screenshot region",
      "action": "screenshot_region",
      "keywords": [
        "screenshot",
        "screen capture",
        "area",
        "selection",
        "crop"
      ],
      "confirm": false,
      "icon": "✂️",
      "description": "Drag to choose an area  ·  macOS shortcut ⇧⌘4  (help screenshot)"
    },
    {
      "id": "weather",
      "title": "weather",
      "action": "weather",
      "keywords": [
        "weather",
        "temperature",
        "forecast",
        "wttr"
      ],
      "confirm": false,
      "icon": "🌤️",
      "description": "Weather now, in a notification  ·  the same as: curl -s \"wttr.in/?format=%c+%t\""
    },
    {
      "id": "briefing",
      "title": "daily briefing",
      "action": "briefing",
      "keywords": [
        "briefing",
        "daily",
        "morning",
        "agenda",
        "today"
      ],
      "confirm": false,
      "icon": "📋",
      "description": "Calendar + inbox + to-do, written by the local model  ·  ml daily-briefing"
    }
  ],
  "notifications": {
    "method": "auto",
    "toast": false,
    "toast_seconds": 2.0
  },
  "secret": {
    "word": "secret",
    "edit_word": "keep_secret",
    "file": "~/.config/mylauncher/secrets.env",
    "clear_seconds": 30,
    "reveal_chars": 4,
    "input_echo": "visible",
    "notify_value": true,
    "keychain_service": "justtothepoint-toolkit"
  },
  "aerospace": {
    "enabled": true,
    "command": "aerospace",
    "workspaces": {}
  },
  "screenshot": {
    "directory": "auto",
    "clipboard": false,
    "delay_seconds": 1
  },
  "ollama": {
    "command": "ollama",
    "host": "http://127.0.0.1:11434",
    "model": "qwen3.8:27b",
    "vision_model": "",
    "think": false,
    "keep_alive": "10m",
    "timeout_seconds": 600,
    "autostart": true,
    "prompts_file": "prompts.json",
    "cache_file": "~/Library/Caches/mylauncher/image-captions.json"
  },
  "timer": {
    "sound": "/System/Library/Sounds/Hero.aiff",
    "repeat": 4,
    "folder": "~/.config/mylauncher/timers",
    "volume": 3,
    "speak": "Time is up",
    "system_volume": 0,
    "big_clock": true,
    "big_clock_seconds": 30,
    "confetti": true
  },
  "weather": {
    "location": "",
    "format": "%c+%t",
    "timeout_seconds": 6
  },
  "power": {
    "force": true,
    "grace_seconds": 8
  },
  "images": {
    "folder": "/Volumes/MacDatosMaster/justtothepoint/static/education/",
    "destination": "~/macOS/claude/skills/daily-gospel/assets"
  },
  "briefing": {
    "gog": "gog",
    "qmd": "qmd",
    "calendar_days": 8,
    "mail_query": "in:inbox",
    "mail_limit": 8,
    "todo_file": "$HOME/macOS/docs/assets/Todo.md",
    "max_chars": 20000,
    "save_folder": ""
  },
  "news": {
    "feeds_file": "feeds.json",
    "default_category": "latest",
    "cache_minutes": 15,
    "days": 7,
    "timeout_seconds": 8,
    "cache_folder": "~/Library/Caches/mylauncher"
  },
  "create_image": {
    "backend": "ollama",
    "ollama_model": "x/z-image-turbo",
    "openrouter_model": "bytedance-seed/seedream-4.5",
    "folder": "~/Pictures/mylauncher",
    "timeout_seconds": 180,
    "open_after": true,
    "keychain_service": "justtothepoint-toolkit",
    "keychain_user": "OPENROUTER_API_KEY"
  }
}