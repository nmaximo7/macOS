{
  "hotkey": {
    "modifiers": ["command"],
    "key": "d"
  },
  "window": {
    "title": "mylauncher",
    "width": 640,
    "font_size": 20,
    "top_offset": 160
  },
  "autostart": {
    "label": "com.mylauncher.app",
    "log_dir": "~/Library/Logs/mylauncher",
    "keep_alive": true
  },
  "expander": {
    "enabled": true,
    "folder": "~/macOS/Espanso/Library/Application Support",
    "strip_cursor_marker": true,
    "notification": true
  },
  "apps": {
    "folders": [
      "/Applications",
      "/System/Applications",
      "/System/Applications/Utilities",
      "~/Applications"
    ],
    "exclude": []
  },
  "search": {
    "max_results": 8,
    "ignore_accents": true,
    "fuzzy": true
  },
  "commands": [
    {
      "id": "shutdown",
      "title": "Shutdown",
      "action": "shutdown",
      "keywords": ["shut down", "power off", "turn off"],
      "confirm": true
    }
  ]
}
